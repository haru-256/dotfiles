{
  "React function component (ReactElement + Props)": {
    "prefix": "rfce",
    "body": [
      "import type { ReactElement } from \"react\";",
      "",
      "interface ${1:Name}Props {",
      "  ${2:prop}: ${3:string};",
      "}",
      "",
      "export default function ${1:Name}({ ${2:prop} }: ${1:Name}Props): ReactElement {",
      "  return (",
      "    <div>",
      "      $0",
      "    </div>",
      "  );",
      "}"
    ],
    "description": "Default export function component with Props interface and ReactElement"
  },
  "React function component (inline props)": {
    "prefix": "rfci",
    "body": [
      "import type { ReactElement } from \"react\";",
      "",
      "export default function ${1:Name}({ ${2:prop} }: { ${2:prop}: ${3:string} }): ReactElement {",
      "  return (",
      "    <div>",
      "      $0",
      "    </div>",
      "  );",
      "}"
    ],
    "description": "Default export function component with inline props (chap03 style)"
  },
  "React function component (no props)": {
    "prefix": "rfcn",
    "body": [
      "import type { ReactElement } from \"react\";",
      "",
      "export default function ${1:Name}(): ReactElement {",
      "  return (",
      "    <div>",
      "      $0",
      "    </div>",
      "  );",
      "}"
    ],
    "description": "Default export function component without props"
  },
  "React named function component": {
    "prefix": "rfne",
    "body": [
      "import type { ReactElement } from \"react\";",
      "",
      "export function ${1:Name}(): ReactElement {",
      "  return (",
      "    <>",
      "      $0",
      "    </>",
      "  );",
      "}"
    ],
    "description": "Named export function component (Banners style)"
  },
  "useState (typed, capitalized setter)": {
    "prefix": "ust",
    "body": [
      "const [${1:count}, set${2:Count}] = useState<${3:number}>(${4:0});"
    ],
    "description": "useState with explicit type and capitalized setter placeholder"
  },
  "useEffect with deps": {
    "prefix": "ued",
    "body": [
      "useEffect(() => {",
      "  $0",
      "}, [${1:deps}]);"
    ],
    "description": "useEffect with dependency array"
  },
  "useEffect with cleanup": {
    "prefix": "uec",
    "body": [
      "useEffect(() => {",
      "  $1",
      "  return () => {",
      "    $0",
      "  };",
      "}, [${2:deps}]);"
    ],
    "description": "useEffect with cleanup and dependency array"
  },
  "Mouse event handler": {
    "prefix": "hem",
    "body": [
      "const handle${1:Click} = (e: MouseEvent<${2:HTMLButtonElement}>) => {",
      "  $0",
      "};"
    ],
    "description": "Typed MouseEvent handler (import MouseEvent from react)"
  },
  "Change event handler": {
    "prefix": "hec",
    "body": [
      "const handle${1:Change} = (e: ChangeEvent<${2:HTMLInputElement}>) => {",
      "  $0",
      "};"
    ],
    "description": "Typed ChangeEvent handler (import ChangeEvent from react)"
  },
  "import type ReactElement": {
    "prefix": "itre",
    "body": ["import type { ReactElement } from \"react\";", "$0"],
    "description": "import type { ReactElement }"
  },
  "import type from react": {
    "prefix": "itr",
    "body": ["import type { $1 } from \"react\";", "$0"],
    "description": "import type { ... } from react"
  },
  "export interface": {
    "prefix": "exi",
    "body": [
      "export interface ${1:Name} {",
      "  ${2:prop}: ${3:string};",
      "  $0",
      "}"
    ],
    "description": "Exported interface (Book style)"
  },
  "export type": {
    "prefix": "ext",
    "body": ["export type ${1:Name} = ${2:string};", "$0"],
    "description": "Exported type alias"
  }
}
